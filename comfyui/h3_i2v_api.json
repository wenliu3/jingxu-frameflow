{
  "_说明": "MiniMax H3 图生视频 · ComfyUI API 格式工作流。给 POST /prompt 用时需包一层 {\"prompt\": <本文件内容>, \"client_id\": \"xxx\"}。带 _注释 的键不会被 ComfyUI 识别，提交前删掉即可。",
  "_调参指南": {
    "length": "总帧数，必须满足 length % 17 == 5（如 73=3秒、107=4.5秒、176=7.3秒）。帧越多越慢。",
    "画质 vs 速度": "想更快：换 4 步 LoRA（minimax_h3_fl2v_turbo_4step_v1.0_768p）+ steps 改 4 + megapixels 降到 0.4~0.6；想更清晰：megapixels 提到 0.98。",
    "seed": "RandomNoise.noise_seed 固定则结果可复现，改成 'randomize' 语义请直接换随机数。"
  },
  "100": { "class_type": "LoadImage", "inputs": { "image": "shot_01.png" } },
  "119": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["100", 0], "megapixels": 0.9, "resolution_steps": 32, "upscale_method": "nearest-exact" } },
  "120": { "class_type": "GetImageSize", "inputs": { "image": ["119", 0] } },
  "6": { "class_type": "UNETLoader", "inputs": { "unet_name": "minimax_h3_fl2va_pruned_bf16.safetensors", "weight_dtype": "default" } },
  "13": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default" } },
  "11": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" } },
  "24": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" } },
  "121": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["6", 0], "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors", "strength_model": 1.0 } },
  "15": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "17": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" } },
  "9": { "class_type": "BasicScheduler", "inputs": { "model": ["121", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0 } },
  "104": { "class_type": "MiniMaxH3ImageToVideo", "inputs": { "clip": ["13", 0], "vae": ["11", 0], "prompt": "在这里填 video_prompt（英文动态描述，H3 不接受负向提示词）", "width": ["120", 0], "height": ["120", 1], "length": 107, "first_frame": ["100", 0] } },
  "16": { "class_type": "BasicGuider", "inputs": { "model": ["121", 0], "conditioning": ["104", 0] } },
  "14": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["15", 0], "guider": ["16", 0], "sampler": ["17", 0], "sigmas": ["9", 0], "latent_image": ["104", 1] } },
  "10": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["11", 0] } },
  "23": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["14", 0], "vae": ["24", 0] } },
  "91": { "class_type": "CreateVideo", "inputs": { "images": ["10", 0], "audio": ["23", 0], "fps": 24 } },
  "92": { "class_type": "SaveVideo", "inputs": { "video": ["91", 0], "filename_prefix": "video/avm", "format": "auto", "codec": "auto" } }
}
